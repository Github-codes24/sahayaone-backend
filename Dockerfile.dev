FROM node:20-alpine

WORKDIR /app

COPY package*.json ./

RUN npm i && npm i -g nodemon

RUN apk add --no-cache \
    curl \
    libreoffice \
    font-dejavu \
    ttf-freefont \
    ttf-liberation \
    tzdata

COPY . .

ENV PORT=5002
ENV TZ=Asia/Kolkata

EXPOSE 5002

# Health check to verify application status on port 5002
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD curl -f http://127.0.0.1:5002/health || wget --spider -q http://127.0.0.1:5002/health || exit 1


CMD ["npm", "run", "dev"]

